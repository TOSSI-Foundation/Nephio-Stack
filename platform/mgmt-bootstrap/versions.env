# Pinned versions — single source of truth (NFR2: anti supply-chain-rot).
# Everything referenced here MUST be mirrored into the private registry for prod (see registry-mirror/).

# Management cluster = REAL Canonical Kubernetes (NOT KIND). Same distro as workload clusters.
# The mgmt cluster is bootstrapped by the distro installer (chicken-and-egg: CAPI can't create
# the cluster it runs on); CAPI+Nephio then provision every OTHER cluster.
# MGMT_LAN_IP = address remote edge hosts use to reach this mgmt API. EMPTY -> auto-detected.
MGMT_LAN_IP=
# --- CLI toolchain the bootstrap needs (installed by install-prereqs.sh / `make prereqs`) ---
GO_VERSION=1.23.5
KUSTOMIZE_VERSION=v5.4.3
CLUSTERCTL_VERSION=v1.14.0
CK8S_CHANNEL=1.32-classic/stable
# NOTE: DNS_UPSTREAMS is defined in the Makefile (multi-word value breaks `. versions.env` in bash).

# Workload cluster distro (default)
WORKLOAD_K8S_VERSION=v1.31.14      # kubeadm fallback; CK8s tracks its own channel

# Cluster API
CAPI_VERSION=v1.9.5
CERT_MANAGER_VERSION=v1.16.2

# Bootstrap/control-plane provider = Canonical Kubernetes
CK8S_VERSION=v0.6.2

# Infrastructure providers
BYOH_VERSION=v0.5.0                # NOTE: VMware registry DEAD -> controller built-from-source, mirror it
# METAL3_VERSION=...               # prod bare-metal (preferred over BYOH)

# Rot fixes (dead upstream -> mirror these)
KUBE_RBAC_PROXY=quay.io/brancz/kube-rbac-proxy:v0.8.0   # gcr.io/kubebuilder is DEAD
BYOH_CONTROLLER_IMAGE=byoh-controller:local              # built from source; push to private registry

# Nephio (installed as kpt packages from the catalog — NOT release-yaml; those assets don't exist).
# The core packages are already VENDORED + committed under ./nephio-packages, so this URL is only a
# fallback re-fetch source (used iff a vendored Kptfile is missing) — points at the canonical upstream.
NEPHIO_CATALOG_REPO=https://github.com/nephio-project/catalog.git
NEPHIO_BRANCH=main
PORCH_VERSION=v1.5.7               # porchctl CLI (Porch server itself = catalog/nephio/core/porch)
KPT_VERSION=v1.0.0-beta.57

# In-cluster git backend (appliance model — no external GitHub dependency)
GITEA_CHART_VERSION=12.7.0         # gitea app 1.27.0
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_PASS=Nephio-Product-1

# Our product images (generic tag for now; set a registry when we mirror/publish)
SDCORE_OPERATOR_IMAGE=sdcore-operator:v0.1.48

# OCUDU gNB image for `ran`-enabled sites (built from source, no public registry; seeded into each cluster).
RAN_GNB_IMAGE=ocudu/gnb:zmq
RAN_GNB_UHD_IMAGE=ocudu/gnb:sdr   # self-contained UHD+FFTW OCUDU (built from source, no host deps)
