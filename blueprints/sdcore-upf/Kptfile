apiVersion: kpt.dev/v1
kind: Kptfile
metadata:
  name: sdcore-upf
  annotations:
    config.kubernetes.io/local-config: "true"
info:
  description: SD-Core BESS UPF blueprint (NFDeployment + interface requests, specialized by Nephio IPAM).
# The SAME specializer functions free5GC uses — they are provider-agnostic. They read the
# Interface/DNN requests and fill in the N3/N4/N6 IPs + VLANs + multus NADs from the VPC pools,
# then merge them into the NFDeployment. Our operator (provider upf.sdcore.io) renders the result.
pipeline:
  mutators:
    - image: ghcr.io/kptdev/krm-functions-catalog/set-annotations:v0.1.4
      configPath: package-context.yaml
    - image: docker.io/nephio/nfdeploy-fn@sha256:f7e18f99c1836b18c5081b5f122c27d5a0161c7cfcb689ce69077b82b8b27718     # assemble the NFDeployment
    - image: docker.io/nephio/interface-fn@sha256:7fd49249b48bd7fe4ef1b3c3c3b600cc321e3c7046db53611ab01fa23b58c8c5    # process n3/n4/n6 interface requests
    - image: docker.io/nephio/dnn-fn@sha256:7f9d0141a69c0702e061dc375577d515987f13a9b46301452895fada41ec3ac7          # process the data network + UE pool
    - image: docker.io/nephio/nad-fn@sha256:d3ff4f02aa9b06d5f6124ed04ef138051636cb127b86dff926ae2edd0f791857          # build the multus NetworkAttachmentDefinitions
    - image: docker.io/nephio/interface-fn@sha256:7fd49249b48bd7fe4ef1b3c3c3b600cc321e3c7046db53611ab01fa23b58c8c5
    - image: docker.io/nephio/nfdeploy-fn@sha256:f7e18f99c1836b18c5081b5f122c27d5a0161c7cfcb689ce69077b82b8b27718
